# Use these if you enable chonkitAuthServer flag in ragu-chat-api repository
# feature `auth-vault`
# VAULT_URL="vault.url.example.com"
# VAULT_ROLE_ID="vault-role-id"
# VAULT_SECRET_ID="vault-secret=id"
# VAULT_KEY_NAME="vault_key_name"

# feature `openai`
OPENAI_KEY="open-ai-key"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000"
CORS_ALLOWED_HEADERS="Access-Control-Allow-Headers,Origin,Accept,X-Requested-With,Content-Type,Access-Control-Request-Method,Access-Control-Request-Headers,X-Google-Drive-Access-Token"
# Cookie config
COOKIE_DOMAIN=localhost

# use this is using feserver
# FEMBED_URL="http://localhost:6969"

# Data source
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/chonkit

UPLOAD_PATH="data/upload"

# feature `weaviate`
WEAVIATE_URL=http://weaviate

# feature `gdrive`
GOOGLE_DRIVE_DOWNLOAD_PATH="data/gdrive"
GOOGLE_OAUTH_CLIENT_ID=google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=-google-oauth-client-secret